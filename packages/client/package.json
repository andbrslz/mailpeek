{
  "name": "@mailpeek-dev/client",
  "version": "0.2.0",
  "description": "TypeScript client for Mailpeek: wait for, inspect and assert on emails in tests.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "email",
    "smtp",
    "testing",
    "e2e",
    "mailpeek"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andbrslz/mailpeek.git",
    "directory": "packages/client"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "vitest": "^5.0.1"
  }
}
